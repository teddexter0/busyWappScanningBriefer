{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules",
    "build",
    "dist"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~*": [
        "./src/*"
      ]
    },
    "types": [
      "chrome",
      "node"
    ],
    "strict": true
  }
}
